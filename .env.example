# Server-side Worker configuration. Copy to .dev.vars, never publish secrets.
# All six Firebase entries must be configured to enable private login.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FISHBOARD_ORIGIN=http://127.0.0.1:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GENERATION_ENABLED=false
WORKERS_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Existing legacy collection only; the new journal does not use OpenAI.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
